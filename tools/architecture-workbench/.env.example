PORT=4000
DATABASE_PATH=./data/architecture-workbench.sqlite
STORAGE_DRIVER=local
LOCAL_OBJECT_DIR=./data/objects

# Optional S3 storage. Use workload identity / IAM roles in deployed environments.
AWS_REGION=ap-northeast-1
S3_BUCKET=
S3_PREFIX=architecture-workbench
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are intentionally not committed.
