PORT=4000
DATABASE_PATH=./data/architecture-workbench.sqlite
STORAGE_DRIVER=local
LOCAL_OBJECT_DIR=./data/objects

# Optional S3 storage. Use workload identity / IAM roles in deployed environments.
AWS_REGION=ap-northeast-1
S3_BUCKET=
S3_PREFIX=architecture-workbench
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are intentionally not committed.

# Remote MCP host allowlist. Empty keeps the MCP endpoint localhost-only.
# Example: MCP_ALLOWED_HOSTS=workbench.example.com
MCP_ALLOWED_HOSTS=

# Enterprise OAuth Resource Server mode. Entra issues tokens; Workbench only validates them.
# The public URL must match the MCP API app registration's Application ID URI exactly.
MCP_AUTH_ENABLED=false
MCP_AUTH_TENANT_ID=
# Entra API app registration client-ID GUID (the v2 access token aud claim).
MCP_AUTH_AUDIENCE=
# Example: https://workbench.example.com/mcp (HTTPS, no trailing slash).
MCP_AUTH_RESOURCE_URL=
# Conventional Entra OAuth metadata identifier. For Entra Agent ID CIMD, use the versioned
# identifier documented by Microsoft, for example .../<tenant-id>/oauth21/2026-08.
MCP_AUTH_AUTHORIZATION_SERVER_URL=
# Client application IDs allowed to call this MCP server (azp claim).
MCP_AUTH_ALLOWED_CLIENT_IDS=
# Define both a delegated API scope and (when needed) an app role with this value.
MCP_AUTH_REQUIRED_SCOPES=mcp.access
# Optional one-time Person linking by a unique Entra email claim. Keep false unless governed.
MCP_AUTH_AUTO_LINK_BY_EMAIL=false

# Legacy prototype remote mode only when MCP_AUTH_ENABLED=false.
# Generate a unique random bearer secret with at least 32 characters.
MCP_BEARER_TOKEN=
# Non-admin Workbench identity used by app-only Agent clients and legacy static-token mode.
MCP_SERVICE_USER_ID=u-agent

# Server-owned Agent Run lease and crash recovery.
# Each claim is valid for this duration and Host heartbeats renew it (15s–5m).
AGENT_RUN_LEASE_MS=60000
# How often the Workbench service scans and recovers expired claims.
AGENT_RUN_LEASE_SWEEP_MS=10000

# Separate pull-based Agent Host process.
MCP_URL=http://localhost:4000/mcp
# Local mode: this principal must be added to each relevant Work Item.
MCP_DEMO_USER_ID=u-agent
# Remote Entra mode: provide a current access token for the Workbench API. The Host does not
# perform interactive sign-in or refresh tokens; the deploying Agent runtime owns token renewal.
MCP_BEARER_TOKEN=
AGENT_EXECUTOR_MODULE=/absolute/path/to/agent-executors.ts
AGENT_HOST_PROFILES=business-analyst,solution-architect,data-architect,security-reviewer,decision-analyst
AGENT_HOST_WORKERS_PER_PROFILE=1
AGENT_HOST_POLL_INTERVAL_MS=3000

# Request discussion and review deadlines (calendar days)
WORKFLOW_REVIEW_DAYS=5
WORKFLOW_CLARIFICATION_DAYS=3
