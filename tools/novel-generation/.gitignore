node_modules/
dist/
.output/*/workbench/
.env

# 原始语料：唯一不入库的内容（约 5.9MB，可由外部来源重新获取）
original.txt

# SQLite 运行时文件：随进程变化，提交没有意义
worlds/*/*.db-wal
worlds/*/*.db-shm

# 知识库导出物：内容是 novel.db 里 novel_* 表的副本，用 story-kb --type export 随时重出
worlds/*/story-kb.json

# 本地覆盖与私有笔记：目录名即约定，需要共享时把文件移到 worlds/<world>/
private/

# 审核包是可从已提交内容重新生成的二进制产物
.output/*.zip

# 离线原文衍生素材与 Vane 原生索引可由本机语料重建，不提交引文副本/二进制段文件
analysis/*/corpus-craft/
worlds/*/vane-index/
