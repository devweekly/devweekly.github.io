{
  "name": "novel-generation",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local-first novel generation with CodeBuddy Agent SDK.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@tencent-ai/agent-sdk": "^0.3.300"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
