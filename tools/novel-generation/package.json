{
  "name": "novel-generation",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local-first novel generation with CodeBuddy Agent SDK.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json && tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck --types node scripts/evaluate-story-memory.ts",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test test/*.test.ts",
    "package-review": "node --import tsx scripts/package-review.ts",
    "dev:web": "tsx src/server-main.ts",
    "start:web": "NODE_ENV=production node dist/server-main.js",
    "compare-models": "node --import tsx scripts/compare-models.ts",
    "evaluate-retrieval": "node --import tsx scripts/evaluate-retrieval.ts",
    "benchmark-local-models": "node --import tsx scripts/benchmark-local-models.ts",
    "evaluate-story-memory": "node --import tsx scripts/evaluate-story-memory.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@tencent-ai/agent-sdk": "^0.3.300",
    "antd": "^6.6.5",
    "express": "^5.2.1",
    "jsonrepair": "^3.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
