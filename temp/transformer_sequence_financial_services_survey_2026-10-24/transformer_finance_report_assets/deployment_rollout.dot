digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45", fontname="Noto Sans CJK SC", label="安全上线：先验证数据与系统，再让模型影响动作", labelloc=t, fontsize=18];
  node [shape=box, style="rounded,filled", color="#3B5875", fillcolor="#EEF4F8", fontname="Noto Sans CJK SC", fontsize=10.5, margin="0.15,0.10"];
  edge [color="#526779", penwidth=1.3, arrowsize=0.7];
  replay [label="Offline replay\n历史决策时点回放"];
  shadow [label="Shadow\n真实请求，仅比较分数"];
  canary [label="Canary\n小比例流量执行新策略", fillcolor="#F8EEDB", color="#AD8430"];
  ab [label="受控 A/B\n预算和护栏预先固定"];
  mature [label="成熟标签后评估\n统计 + 业务意义"];
  full [label="扩大流量 / 常态运行", fillcolor="#DCECE8", color="#397D70"];
  rollback [label="异常、超时或护栏恶化\n立即回退旧模型/规则", fillcolor="#F4E5E5", color="#9A5555"];
  replay -> shadow -> canary -> ab -> mature -> full;
  shadow -> rollback [style=dashed, color="#9A5555"];
  canary -> rollback [style=dashed, color="#9A5555"];
  ab -> rollback [style=dashed, color="#9A5555"];
}
